        val = data[i, j]
        intensity = 0.20 + 0.85 * (val / max_val) if val > 0 else 0.15
        cell_color = np.array(base_rgb) * intensity + np.array([1, 1, 1]) * (1 - intensity)
        rect = plt.Rectangle(
