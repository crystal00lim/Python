tet_f = filtered['arg'].astype(str).str.contains('tet', case=False, na=False)
tet = filtered[tet_f]
# print(tet)
tet = tet[tet['organism'] == 'Staphylococcus aureus']

# print(s_tet)

seq_type = tet['sequence_type'].unique()
# print(seq_type) # the y-axis of the heatmap

before = doxy_before_study.drop_duplicates(subset=['microbio_sample_id']).set_index('microbio_sample_id')['study_statdoxyrx']
after = doxy_after_study.drop_duplicates(subset=['microbio_sample_id']).set_index('microbio_sample_id')['study_statdoxyrx']
