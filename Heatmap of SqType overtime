pass_wgs['participant_id'] = pass_wgs['timepoint_id'].str.rsplit('_', n=1).str[0]
pass_wgs = pass_wgs.sort_values(['participant_id', 'visit_date'])
visit1 = pass_wgs.groupby('participant_id')['visit_date'].transform('first')
pass_wgs['v1'] = (pass_wgs['visit_date'] - visit1).dt.days
